{
  "name": "orbiaapp",
  "version": "0.1.0",
  "private": true,
  "description": "ORBIA — plataforma de gestão condominial multi-tenant",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch backend/src/server.js",
    "start": "node backend/src/server.js",
    "db:migrate": "node backend/src/db/migrate.js",
    "check": "node scripts/check.js",
    "build": "node scripts/build.js",
    "test": "node --test backend/test/*.test.js frontend/test/*.test.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jsdom": "31.0.1"
  }
}
